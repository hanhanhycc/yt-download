# ---- General ----
PROJECT_NAME=yt-download
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Backend ----
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Public URL of the backend (used to build download links)
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated CORS origins (frontend URL etc.)
CORS_ORIGINS=http://localhost:3000

# ---- Admin bootstrap (created on first start) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# ---- Database ----
POSTGRES_USER=ytdl
POSTGRES_PASSWORD=ytdl
POSTGRES_DB=ytdl
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://ytdl:ytdl@db:5432/ytdl

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Storage ----
# Inside container path; mapped to ./storage on host via docker-compose
DOWNLOAD_DIR=/data/downloads
MAX_FILE_SIZE_MB=2048
JOB_TIMEOUT_SECONDS=3600

# ---- Quotas / limits ----
DEFAULT_DAILY_JOB_QUOTA=50
DEFAULT_CONCURRENT_JOBS=3
DOWNLOAD_TOKEN_TTL_SECONDS=86400

# ---- URL filtering ----
# Comma-separated. Leave ALLOWED_DOMAINS empty to allow all (except blocked).
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0,169.254.169.254

# ---- Bot API ----
# Static API key used by Telegram / AI bots to call /api/bot endpoints
BOT_API_KEY=change-me-bot-key

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
