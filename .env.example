# Copy to .env and edit. Used by docker-compose for the single-container build.

# Security — set a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login (created on first start).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Set to true ONCE to (re)set the admin password from ADMIN_PASSWORD on boot,
# then set back to false. Lets you recover a lost password without a terminal.
ADMIN_RESET_ON_BOOT=false

# Public URL used to build download links. On a NAS use http://<nas-ip>:8182.
PUBLIC_BASE_URL=http://localhost:8182

# Static key for the bot/AI endpoints (/api/bot/*).
BOT_API_KEY=change-me-bot-key

# How many downloads run at once.
DOWNLOAD_CONCURRENCY=2
MAX_FILE_SIZE_MB=4096

# yt-dlp cookies to get past YouTube's "Sign in to confirm you're not a bot".
# base64 of a Netscape cookies.txt exported from a logged-in (throwaway) account:
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
#   Linux/macOS: base64 -w0 cookies.txt
YTDLP_COOKIES_B64=
